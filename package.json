  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipseth/decision-pipeline.git"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./jsonata": "./src/jsonata.ts"
  },
  "scripts": {
    "lint": "echo 'no lint configured'",
    "type-check": "tsc --noEmit",
